# Single-user defaults. Copy to .env; do not commit credentials.
PORT=8888
TOMATO_TAP_BIND_HOST=127.0.0.1
TOMATO_TAP_LOG_KEY_INVENTORY=false
TOMATO_TAP_EXPOSE_UPSTREAM_HOSTS=false
TOMATO_TAP_ADMIN_DETAIL_LEVEL=safe

# The local console is available at http://127.0.0.1:8888/admin/.
# A token is optional on loopback. It is mandatory for management APIs when
# binding beyond loopback; also restrict remote access with a firewall.
# TOMATO_TAP_ADMIN_TOKEN=replace-with-a-long-random-value

# Optional mutable-data locations. New installs already default to ./runtime.
# TOMATO_TAP_STATE_DIR=/var/lib/tomato-tap
# TOMATO_TAP_RUNTIME_DIR=/run/user/1000/tomato-tap

# Upstream/credential storage. files is the portable default. sqlite imports
# the current local files on first start; auto uses an already active DB.
TOMATO_TAP_CONFIG_BACKEND=files
# TOMATO_TAP_CONFIG_DB_PATH=/var/lib/tomato-tap/tomato-config.db

# Optional configuration overrides. Keep private inventories under
# config/local/ (ignored by Git) and point these variables at them.
# TOMATO_TAP_CONFIG_DIR=/absolute/path/to/private-config
# TOMATO_TAP_VENDORS_PATH=/absolute/path/to/config/local/vendors.json
# TOMATO_TAP_RELAYS_PATH=/absolute/path/to/config/local/relays.json
# TOMATO_TAP_MODELS_PATH=/absolute/path/to/config/local/models.json
# TOMATO_TAP_PRICING_OVERRIDES_PATH=/absolute/path/to/private/pricing-overrides.json

# Optional accounting window. Defaults permit the full UTC day.
TOMATO_TAP_DAILY_CREDIT_BUDGET=9007199254740991
TOMATO_TAP_WINDOW_START_UTC_HOUR=0
TOMATO_TAP_WINDOW_END_UTC_HOUR=24
TOMATO_TAP_OFFPEAK_MULTIPLIER=1
# Optional private model-pattern to credit-multiplier map, longest match wins.
# TOMATO_TAP_MODEL_CREDIT_MULTIPLIERS={"premium-model":2}
TOMATO_TAP_DEFAULT_USER_AGENT=tomato-tap/0.3.0

# Buffered gateway safety limits.
TOMATO_TAP_MAX_REQUEST_SIZE=32MiB
TOMATO_TAP_MAX_RESPONSE_SIZE=32MiB
TOMATO_TAP_ORDINARY_FIRST_BYTE_TIMEOUT=2m
TOMATO_TAP_ORDINARY_TOTAL_TIMEOUT=10m
TOMATO_TAP_SERVER_REQUEST_TIMEOUT=2m
TOMATO_TAP_SERVER_HEADERS_TIMEOUT=30s
TOMATO_TAP_SERVER_KEEP_ALIVE_TIMEOUT=5s
TOMATO_TAP_SERVER_MAX_REQUESTS_PER_SOCKET=1000
TOMATO_TAP_SHUTDOWN_GRACE_TIMEOUT=150s

# A deployment/model pair that returns an invalid response is temporarily
# removed from dispatch, then admitted for one recovery probe after backoff.
TOMATO_TAP_QUALIFICATION_BACKOFF_BASE=30s
TOMATO_TAP_QUALIFICATION_BACKOFF_MAX=15m

# Raw prompt/response samples are opt-in.
TOMATO_TAP_SAMPLES_ENABLED=false
TOMATO_TAP_SAMPLES_RETENTION=24h
TOMATO_TAP_SAMPLES_MAX_SIZE=512MiB
TOMATO_TAP_SAMPLES_CLEANUP_INTERVAL=1h

# Durable usage ledger. Rotation is atomic; archives remain queryable.
TOMATO_TAP_USAGE_LOG_MAX_SIZE=1GiB
TOMATO_TAP_USAGE_ARCHIVE_MAX_SIZE=4GiB
TOMATO_TAP_USAGE_RETENTION=90d
TOMATO_TAP_USAGE_MAINTENANCE_INTERVAL=5m

# Optional sticky egress. Subscription URLs and raw nodes are credentials;
# define them only in .env or another protected TOMATO_TAP_ENV_FILE.
# TOMATO_TAP_PROXY_SUBSCRIPTION_URL=https://example.invalid/private-subscription
# TOMATO_TAP_PROXY_SUBSCRIPTION_URLS=https://example.invalid/a,https://example.invalid/b
# TOMATO_TAP_PROXY_STATIC_NODES=<private-node-uri>
# TOMATO_TAP_SING_BOX_BIN=sing-box
# TOMATO_TAP_PROXY_PORT_START=11001
# TOMATO_TAP_PROXY_PORT_END=11999

# Optional shared proxy. Relays opt in with `proxy: true`; one whole vendor can
# be selected with TOMATO_TAP_SHARED_PROXY_VENDOR. Per-deployment fixed proxy URLs
# use the secret env namespace tomato_tap_relay_<deployment>_proxy_url.
# TOMATO_TAP_SHARED_PROXY_URL=http://127.0.0.1:7890
# TOMATO_TAP_SHARED_PROXY_VENDOR=relay
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
NO_PROXY=127.0.0.1,localhost,::1

# relays.json maps this suffix to config/relays.json -> relays.example.
# Never commit a populated value.
# tomato_tap_relay_example_key=replace-me
