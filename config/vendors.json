{
  "schemaVersion": 1,
  "_doc": "Safe starter configuration. Credentials belong in .env and deployment metadata belongs in relays.json.",
  "vendors": [
    {
      "id": "relay",
      "displayName": "OpenAI-compatible relays",
      "description_en": "Generic OpenAI-compatible deployments declared in relays.json.",
      "description_zh": "在 relays.json 中声明的通用 OpenAI 兼容部署。",
      "category": "aimd-pool",
      "envDiscovery": "multi",
      "envPrefix": "^(?:tomato_tap|mimotap)_relay_(.+?)_key$",
      "routes": [
        {
          "prefix": "/oa/v1",
          "apiFormat": "openai",
          "auth": "bearer",
          "rewrite": {
            "from": "^/oa/v1",
            "to": ""
          }
        },
        {
          "prefix": "/anthropic",
          "apiFormat": "anthropic",
          "auth": "x-api-key",
          "rewrite": {
            "from": "^/anthropic",
            "to": ""
          }
        }
      ]
    },
    {
      "id": "cursor_acp",
      "displayName": "Cursor Agent ACP bridge",
      "description_en": "Optional loopback-only text bridge from OpenAI Chat Completions to Cursor Agent Client Protocol.",
      "description_zh": "可选的纯本地文本桥接，将 OpenAI Chat Completions 转为 Cursor Agent Client Protocol。",
      "category": "local-agent-bridge",
      "envDiscovery": "single",
      "envPrefix": "^tomato_tap_cursor_acp_credential$",
      "defaultHost": "127.0.0.1",
      "nativeModels": ["cursor-agent"],
      "logicalEligible": false,
      "preserveIncomingBody": true,
      "preserveIncomingHeaders": true,
      "requestTimeouts": {
        "firstByteMs": 120000,
        "totalMs": 600000
      },
      "routes": [
        {
          "prefix": "/cursor/v1",
          "apiFormat": "openai",
          "auth": "bearer",
          "rewrite": {
            "from": "^/cursor/v1",
            "to": ""
          }
        }
      ]
    }
  ]
}
